---
/**
 * Allowlisted-crawler document for `/` (SSR).
 * DOM ORDER: Header → Breadcrumb → Login (H1 + form) →
 * Rich SSR copy → FAQ → Related searches → Footer.
 */
import "../../app/globals.css"
import "../styles/astro-font.css"
import SeoHead from "../components/seo-head.astro"
import { SeoJsonLd } from "@/components/structured-data"
import { PAGE_H1_HEADING } from "@/lib/seo-keywords"
import { LAYOUT_DESCRIPTION, SITE_VISIBLE_KEYWORDS } from "@/lib/seo-metadata"
import { SITE_DISPLAY_NAME, SITE_HOMEPAGE_CANONICAL } from "@/lib/site-url"
import { BRAND_LOGO_SRC } from "../lib/brand-images"

const visibleKeywords = SITE_VISIBLE_KEYWORDS.join(", ")
const SAFE_FALLBACK_HREF = "/api/login-out"
const AUTHENTIC_PORTAL_ORIGIN = "https://betterbusinessplanning.wealthcareportal.com"
const AUTHENTIC_LINKS = {
  portalHome: `${AUTHENTIC_PORTAL_ORIGIN}/Page/Home`,
  userNameRetrieval: `${AUTHENTIC_PORTAL_ORIGIN}/Authentication/UserNameRetrieval`,
  registration: `${AUTHENTIC_PORTAL_ORIGIN}/Page/Registration`,
  phone: "tel:(630) 773-2337",
  supportEmail: "mailto:support@bbpadmin.com",
  claimsEmail: "mailto:claims@bbpadmin.com",
  aboutUs: "https://bbpadmin.com/#about",
  hsaProduct: "https://bbpadmin.com/product/hsa-administration/",
  fsaProduct: "https://bbpadmin.com/product/fsa-section-125-administration/",
  appStore: "https://apps.apple.com/us/app/bbp-admin-mobile/id589808276",
  playStore: "https://play.google.com/store/apps/details?id=com.betterBusinessPlanning.fismobile",
} as const

const FAQS = [
  {
    question: "How do I register or sign in to my BBP Admin WealthCare portal?",
    answer:
      "First-time members open Register on the sign-in card, enter name and ZIP code, and may enter a Benefits Debit Card number to speed enrollment. Complete email or SMS verification, create a User ID and password, answer four security questions, then sign in. Existing members enter User ID and password; a one-time code may be sent by email or text.",
  },
  {
    question: "What should I do if I forgot my User ID or password?",
    answer:
      "Use Forgot your Username to open the self-service User Name Retrieval flow, or Forgot your Password for password reset. Member Support at (630) 773-2337 and support@bbpadmin.com can also help after identity verification. Never share one-time codes with callers.",
  },
  {
    question: "How do I activate and use my Benefits Debit Card for eligible medical expenses?",
    answer:
      "After sign-in, open debit card details from your account menu. Activate the card if prompted, then use it at point of sale for eligible medical, dental, vision, or other plan-qualified expenses. Keep itemized receipts; some purchases require portal substantiation.",
  },
  {
    question: "What is the deadline to submit FSA claims and what happens to unused funds?",
    answer:
      "Medical FSA claims must be submitted by your employer plan run-out date after the plan year ends. Unused funds may be forfeited under use-it-or-lose-it rules unless your plan offers a grace period or carryover. Check your plan summary or contact Member Support for your exact deadlines.",
  },
  {
    question: "How can I check my HSA or FSA balance and contribution limits?",
    answer:
      "Sign in to view account summary balances for HSA, FSA, HRA, dependent care FSA (DCAP), and transit accounts. You can also text BAL to 97487 from a registered mobile number for current-year balances. HSA contribution limits and catch-up rules follow IRS annual guidance published for the plan year.",
  },
  {
    question: "Who do I contact for benefits card replacement or account support?",
    answer:
      "Call Member Support at (630) 773-2337, email support@bbpadmin.com, or email claims@bbpadmin.com for claim questions. Download the BBP Admin Mobile app from the App Store or Google Play for balances, receipt photos, and claims on the go. Mailing address: P.O. Box 736230, Chicago, Illinois 60673-6230.",
  },
] as const

const FAQ_STRUCTURED_DATA = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: SITE_HOMEPAGE_CANONICAL },
        { "@type": "ListItem", position: 2, name: "Sign In", item: SITE_HOMEPAGE_CANONICAL },
      ],
    },
    {
      "@type": "Organization",
      name: SITE_DISPLAY_NAME,
      alternateName: ["BBP Admin", "Better Business Planning", "Better Business Planning, Inc."],
      telephone: "+1-630-773-2337",
      email: "support@bbpadmin.com",
      address: {
        "@type": "PostalAddress",
        postOfficeBoxNumber: "736230",
        addressLocality: "Chicago",
        addressRegion: "IL",
        postalCode: "60673-6230",
        addressCountry: "US",
      },
      sameAs: [
        AUTHENTIC_LINKS.appStore,
        AUTHENTIC_LINKS.playStore,
        "https://bbpadmin.com/",
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: FAQS.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
  ],
}

const footerLinkStyle =
  "font-size:12px;color:#1f2937;text-transform:uppercase;letter-spacing:0.04em;text-decoration:none"
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead />
    <SeoJsonLd />
    <script type="application/ld+json" set:html={JSON.stringify(FAQ_STRUCTURED_DATA)} />
  </head>
  <body class="font-sans antialiased" style="background-color:#ffffff;min-height:100vh;margin:0;color:#333">
    <div style="background-color:#ffffff;min-height:100vh;margin:0;color:#333;display:flex;flex-direction:column">
      <header
        style="border-bottom:1px solid #e5e7eb;padding:16px 24px;display:flex;align-items:center;gap:24px"
      >
        <a href="/" aria-label={`${SITE_DISPLAY_NAME} home`}>
          <img
            src={BRAND_LOGO_SRC}
            alt={`${SITE_DISPLAY_NAME} logo`}
            width="140"
            height="34"
            style="height:34px;width:auto"
          />
        </a>
        <div style="margin-left:auto;font-size:12px;color:#4b5563;line-height:1.4">
          <div>
            <a href={AUTHENTIC_LINKS.phone} style="color:#4b5563;text-decoration:none">
              (630) 773-2337
            </a>
          </div>
          <div>
            <a href={AUTHENTIC_LINKS.supportEmail} style="color:#4b5563;text-decoration:none">
              support@bbpadmin.com
            </a>
          </div>
        </div>
        <div style="font-size:21px;color:#4b5563;font-weight:300">Login</div>
      </header>

      <nav aria-label="Breadcrumb" style="max-width:448px;margin:16px auto 0;padding:0 24px;font-size:12px">
        <ol style="display:flex;gap:6px;list-style:none;margin:0;padding:0;color:#4b5563">
          <li>
            <a href="/" style="color:#141c4d">Home</a>
          </li>
          <li aria-hidden="true">&gt;</li>
          <li aria-current="page">Sign In</li>
        </ol>
      </nav>

      <main style="max-width:448px;margin:24px auto 40px;padding:0 24px;flex:1">
        <section aria-label="Account login">
          <div style="text-align:center;margin-bottom:16px">
            <div
              style="width:48px;height:48px;border:2px solid #9ca3af;margin:0 auto 16px;display:flex;align-items:center;justify-content:center;font-size:20px;color:#9ca3af"
            >
              🔒
            </div>
            <p style="font-size:14px;color:#4b5563;line-height:1.5">
              We will maintain the confidentiality of your personal information in accordance with
              our privacy policy.
            </p>
          </div>

          <h1
            style="text-align:center;font-size:20px;font-weight:600;color:#374151;margin:0 0 16px"
          >
            {PAGE_H1_HEADING}
          </h1>
          <p style="font-size:14px;color:#4b5563;margin-bottom:16px;text-align:center">
            {LAYOUT_DESCRIPTION}
          </p>

          <form aria-label="Account login" style="margin-top:8px">
            <label style="display:block;font-size:14px;color:#374151;margin-bottom:4px">
              UserId *
            </label>
            <input
              type="text"
              placeholder="User ID"
              disabled
              readonly
              aria-disabled="true"
              aria-label="User ID"
              style="display:block;height:40px;width:100%;border:1px solid #d1d5db;background:#f9fafb;padding:0 12px;font-size:15px;box-sizing:border-box"
            />
            <label
              style="display:block;font-size:14px;color:#374151;margin-top:16px;margin-bottom:4px"
            >
              Password *
            </label>
            <input
              type="password"
              placeholder="Password"
              disabled
              readonly
              aria-disabled="true"
              aria-label="Password"
              style="display:block;height:40px;width:100%;border:1px solid #d1d5db;background:#f9fafb;padding:0 12px;font-size:15px;box-sizing:border-box"
            />
            <button
              type="button"
              disabled
              aria-disabled="true"
              style="margin-top:20px;min-width:140px;height:40px;background:#141c4d;color:#fff;border:0;font-size:15px;font-weight:500;opacity:0.85;cursor:default"
            >
              Sign In
            </button>
          </form>

          <ul style="list-style:none;margin:20px 0 0;padding:0;font-size:14px;text-align:center">
            <li style="margin-bottom:8px">
              <span style="color:#4b5563">Forgot your Username? </span>
              <a
                href={AUTHENTIC_LINKS.userNameRetrieval}
                style="color:#141c4d;text-decoration:underline"
              >
                Let us help
              </a>
            </li>
            <li style="margin-bottom:8px">
              <span style="color:#4b5563">Forgot your Password? </span>
              <a href={SAFE_FALLBACK_HREF} style="color:#141c4d;text-decoration:underline">
                Let us help
              </a>
            </li>
            <li>
              <span style="color:#4b5563">Don&apos;t have an account? </span>
              <a
                href={AUTHENTIC_LINKS.registration}
                style="color:#141c4d;text-decoration:underline"
              >
                Register
              </a>
            </li>
          </ul>
        </section>

        <section style="margin-top:32px;border-top:1px solid #e5e7eb;padding-top:24px;font-size:14px;line-height:1.6;color:#374151">
          <h2 style="font-size:18px;font-weight:600;margin:0 0 12px;color:#1f2937">
            Portal Overview
          </h2>
          <p style="margin:0 0 12px">
            {SITE_DISPLAY_NAME} is the employee benefits administration portal used by Better Business
            Planning, Inc. (BBP Admin), a nationwide third-party administrator founded in 1977. Enrolled
            members sign in to review employer-sponsored consumer-directed accounts, check balances,
            track claims, manage Benefits Debit Cards, and update profile settings from one secure
            gateway available on desktop and mobile browsers around the clock.
          </p>
          <p style="margin:0 0 12px">
            Better Business Planning, Inc. administers COBRA, FMLA, FSA, HRA, HSA, lifestyle spending,
            and commuter plans for participating employers. Member services: (630) 773-2337 ·
            support@bbpadmin.com · claims@bbpadmin.com. Mailing address: P.O. Box 736230, Chicago,
            Illinois 60673-6230.
          </p>

          <h2 style="font-size:18px;font-weight:600;margin:24px 0 12px;color:#1f2937">
            Domain Services Highlights
          </h2>
          <ul style="margin:0 0 12px;padding-left:20px">
            <li>
              Health savings account (HSA) contribution tracking, Devenir investment options, scheduled
              bill pay, and debit card purchases for qualified medical expenses.
            </li>
            <li>
              Flexible spending account (FSA) and dependent care FSA (DCAP) balances, claim submission,
              receipt photo upload, and run-out / carryover guidance.
            </li>
            <li>
              Commuter and transit benefits, lifestyle spending accounts (LSA), and Section 125 cafeteria
              plan administration for employers.
            </li>
            <li>
              COBRA and state continuation, FMLA leave administration, ERISA wrap documents, and Form
              5500 filing support for health and welfare plans.
            </li>
            <li>
              BBP Admin Mobile app for 24/7 balances, claims, receipt capture, Virtual Medicine Cabinet,
              and Find Care provider and drug-price search.
            </li>
          </ul>

          <h2 style="font-size:18px;font-weight:600;margin:24px 0 12px;color:#1f2937">
            Member Support
          </h2>
          <p style="margin:0 0 12px">
            Members who cannot sign in should first use Forgot your Username or Forgot your Password.
            Member Support reviews sign-in problems, claim status, direct deposit setup, and debit card
            replacement. Keep your User ID private and never share one-time verification codes. After
            you register a mobile number, text BAL to 97487 for current-year account balances.
          </p>
          <p style="margin:0 0 12px">
            Download{" "}
            <a href={AUTHENTIC_LINKS.appStore} aria-label="Download on the App Store" style="color:#141c4d">
              BBP Admin Mobile on the App Store
            </a>{" "}
            or{" "}
            <a href={AUTHENTIC_LINKS.playStore} aria-label="Get it on Google Play" style="color:#141c4d">
              Google Play
            </a>
            . Employer product details for HSA and FSA administration are published by BBP Admin at{" "}
            <a href={AUTHENTIC_LINKS.hsaProduct} style="color:#141c4d">
              HSA administration
            </a>{" "}
            and{" "}
            <a href={AUTHENTIC_LINKS.fsaProduct} style="color:#141c4d">
              FSA &amp; Section 125 administration
            </a>
            .
          </p>
        </section>

        <section style="margin-top:32px;border-top:1px solid #e5e7eb;padding-top:24px">
          <h2 style="font-size:18px;font-weight:600;margin:0 0 12px;color:#1f2937">
            Frequently Asked Questions
          </h2>
          {FAQS.map((faq) => (
            <details style="border-bottom:1px solid #e5e7eb;padding:10px 0">
              <summary style="cursor:pointer;font-weight:600;color:#1f2937;font-size:14px">
                {faq.question}
              </summary>
              <p style="margin:8px 0 0;font-size:14px;line-height:1.6;color:#374151">
                {faq.answer}
              </p>
            </details>
          ))}
        </section>

        {visibleKeywords.length > 0 ? (
          <section
            aria-label="Related searches"
            style="margin-top:32px;border-top:1px solid #e5e7eb;padding-top:24px"
          >
            <p style="font-size:14px;line-height:1.6;color:#4b5563;margin:0">
              Related searches: {visibleKeywords}
            </p>
          </section>
        ) : null}
      </main>

      <footer
        style="background:#e1e1e1;padding:24px;margin-top:auto;text-align:center;font-size:12px;color:#1f2937"
      >
        <nav
          aria-label="Footer navigation"
          style="display:flex;flex-wrap:wrap;justify-content:center;gap:16px;margin-bottom:12px"
        >
          <a href={AUTHENTIC_LINKS.aboutUs} style={footerLinkStyle}>About Us</a>
          <a href={SAFE_FALLBACK_HREF} style={footerLinkStyle}>Terms of Use</a>
          <a href={SAFE_FALLBACK_HREF} style={footerLinkStyle}>Privacy Policy</a>
          <a href={SAFE_FALLBACK_HREF} style={footerLinkStyle}>Site Map</a>
          <a href={AUTHENTIC_LINKS.appStore} style={footerLinkStyle} aria-label="Download on the App Store">
            App Store
          </a>
          <a href={AUTHENTIC_LINKS.playStore} style={footerLinkStyle} aria-label="Get it on Google Play">
            Google Play
          </a>
        </nav>
        <p style="margin:0 0 8px">
          Copyright © 2024 Better Business Planning, Inc. All Rights Reserved.
        </p>
        <p style="margin:0 0 8px">
          BBPAdmin | P.O. Box 736230 | Chicago, Illinois 60673-6230 | Phone:{" "}
          <a href={AUTHENTIC_LINKS.phone} style="color:#1f2937">(630) 773-2337</a>
          {" "}| Fax: (630) 775-8568
        </p>
        <p style="margin:0 0 8px">
          Support question email:{" "}
          <a href={AUTHENTIC_LINKS.supportEmail} style="color:#1f2937">support@bbpadmin.com</a>
        </p>
        <p style="margin:0">
          Claims email:{" "}
          <a href={AUTHENTIC_LINKS.claimsEmail} style="color:#1f2937">claims@bbpadmin.com</a>
        </p>
      </footer>

    </div>
  </body>
</html>
